# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# DATABASE - NEON POSTGRESQL
# ==========================================
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DATABASE?sslmode=require

# ==========================================
# REDIS - UPSTASH
# ==========================================
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379

# ==========================================
# BULLMQ
# ==========================================
QUEUE_NAME=seo-audit-jobs

# ==========================================
# CLAUDE API
# ==========================================
ANTHROPIC_API_KEY=YOUR_CLAUDE_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-6

# ==========================================
# MOCK INTEGRATIONS
# ==========================================
USE_MOCKS=true

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=YOUR_RANDOM_SECRET_KEY

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# REPORT GENERATION
# ==========================================
REPORTS_DIR=./tmp/reports

# ==========================================
# ADMIN ACCOUNT
# ==========================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_PASSWORD=CHANGE_THIS_PASSWORD

# ==========================================
# EMAIL
# ==========================================
EMAIL_FROM=reports@example.com

# Legacy variable names still used by existing app modules.
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL_POOLED=
DATABASE_SSL=auto
UPSTASH_REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379
GEMINI_API_KEY=
REPORT_STORAGE_DIR=./reports
SEED_SAMPLE_CLIENT_EMAIL=
SEED_SAMPLE_CLIENT_PASSWORD=

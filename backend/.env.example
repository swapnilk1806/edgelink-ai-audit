NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://postgres:password@localhost:5432/edgelink_seo
# Optional pooled runtime connection; keep DATABASE_URL as the direct migration connection.
DATABASE_URL_POOLED=
# auto disables TLS for localhost and enables certificate-verified TLS for remote production databases
DATABASE_SSL=auto
# Upstash Redis TCP URL from the database Connect page (not the HTTPS REST URL/token)
UPSTASH_REDIS_URL=rediss://default:your-redis-password@your-endpoint.upstash.io:6379
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
USE_MOCKS=true
REPORT_STORAGE_DIR=./reports
# Optional production object storage (Cloudflare R2 S3-compatible endpoint)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional real email transport can be connected here; demo delivery is logged.
EMAIL_FROM=reports@example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_PASSWORD=choose-a-long-password
SEED_SAMPLE_CLIENT_EMAIL=
SEED_SAMPLE_CLIENT_PASSWORD=

{
  "name": "edgelink-seo-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "worker": "tsx --tsconfig tsconfig.json src/workers/seo-audit.worker.ts",
    "db:seed": "tsx --tsconfig tsconfig.json src/db/seed.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium": "^130.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "puppeteer-core": "^23.6.0",
    "redis": "^6.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "prisma": "^6.19.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}

# Local Next.js server environment.
# Keep server-side secrets unprefixed; NEXT_PUBLIC_* values are exposed to the browser.
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_POOLED=
DATABASE_SSL=auto
UPSTASH_REDIS_URL=rediss://default:PASSWORD@HOST:6379
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
USE_MOCKS=true
REPORT_STORAGE_DIR=./reports

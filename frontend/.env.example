# Local Next.js server environment.
# Keep these values in sync with backend/.env. Backend settings are loaded first.
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_POOLED=
DATABASE_SSL=auto
UPSTASH_REDIS_URL=rediss://default:PASSWORD@HOST:6379
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
USE_MOCKS=true
REPORT_STORAGE_DIR=./reports
